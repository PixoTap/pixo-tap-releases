// 由 tools/publish-edge.mjs 自动生成，请勿手工编辑。
// D1 database_id 沿用源码配置，EDGE_D1_ID 可覆盖；缺省才用占位符。跨账号部署前必须创建该账号自己的 D1。
// Secret 名称：PASSWORD_PEPPER、JWT_PRIVATE_KEY、CODE_HMAC_KEY、CSRF_KEY、LOG_HMAC_KEY、OUTBOX_KEY、SMTP_PASS（只在控制台或 wrangler secret put 中设置）。
// 见主仓库 docs/CLOUDFLARE_SETUP.md。
{
  "$schema": "https://workers.cloudflare.com/wrangler-config-schema.json",
  "name": "pixotap",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/*",
      "/healthz",
      "/readyz",
      "/.well-known/jwks.json",
      "/account/*",
      "/admin/*",
      "/install",
      "/install.ps1",
      "/install-mac"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixotap-db",
      "database_id": "a4c7d0c2-fd28-4457-8d83-326f1b54fd69"
    }
  ],
  "ratelimits": [
    {
      "name": "RL_IP",
      "namespace_id": "770001",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "RL_USER",
      "namespace_id": "770002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_DEVICE_CODE",
      "namespace_id": "770003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_DEVICE_TOKEN",
      "namespace_id": "770004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "NODE_ENV": "production",
    "TRUST_PROXY": "true",
    "AUTH_ISSUER": "https://pixotap.com",
    "AUTH_AUDIENCE": "pixotap-api",
    "SITE_ORIGIN": "https://pixotap.com",
    "MIN_AGE": "14",
    "SMTP_HOST": "smtp.yeah.net",
    "SMTP_PORT": "465",
    "SMTP_USER": "pixotap@yeah.net",
    "MAIL_FROM": "pixotap@yeah.net",
    "RELEASES_REPO": "PixoTap/pixo-tap-releases",
    "RELEASES_CACHE_REVISION": "8dedc5e7ee0daec6"
  }
}
